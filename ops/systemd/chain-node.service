[Unit]
Description=BNB Verifiable Rust Chain Node
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/opt/bnb/node
EnvironmentFile=/home/ubuntu/opt/bnb/node/.env
ExecStart=/home/ubuntu/opt/bnb/node/target/release/verifiable-rust-chain-node
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
