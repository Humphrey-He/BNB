# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=asset_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform123

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS
NATS_URL=nats://localhost:4222

# RPC Providers (configure per chain)
# ETHEREUM_RPC_URL=https://eth.llamarpc.com
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# POLYGON_RPC_URL=https://polygon.llamarpc.com

# App
APP_ENV=development
LOG_LEVEL=debug
PORT=8080
BIND_ADDR=127.0.0.1

# Management API
API_AUTH_TOKEN=replace-with-long-random-token

# Withdrawal risk controls
WITHDRAWAL_HOT_WALLET_ADDRESS=0x1234567890123456789012345678901234567890
WITHDRAWAL_MAX_AUTO_APPROVE_AMOUNT=1000000000000000000
WITHDRAWAL_REQUIRE_WHITELIST=true
WITHDRAWAL_ALLOWED_DESTINATIONS=0xabcdefabcdefabcdefabcdefabcdefabcdefabcd

# Withdrawal signer (testnet only)
WITHDRAWAL_SIGNER_PRIVATE_KEY=0xyour_testnet_private_key
